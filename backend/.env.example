# Copy this file to `.env` and fill in your own values.
# Never commit real secrets — this file must only ever contain placeholders.

# ── Required secrets ──────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Optional — only needed if you use the github_search tool with higher rate limits
GITHUB_TOKEN=your_github_token_here

# Optional — LangSmith tracing
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=synapse-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Models ─────────────────────────────────────────────────────────────────
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Fallback used when the primary model returns a malformed/failed tool call.
GROQ_TOOL_FALLBACK_MODEL=qwen/qwen3.8-27b
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
# Vision model used for image uploads (see file_service.py).
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Lightweight secondary model used only by the adaptive evaluator — kept
# separate from GROQ_CHAT_MODEL so the primary 120B model is never swapped.
GROQ_LOOP_EVALUATOR_MODEL=openai/gpt-oss-20b

# ── Adaptive Agent Loop ──────────────────────────────────────────────────
# Emergency rollback switch — set to false to fully disable the adaptive
# evaluator and restore the original single tool-loop behavior with no
# code changes required.
ADAPTIVE_LOOP_ENABLED=true
# Max evaluator invocations per user turn.
ADAPTIVE_LOOP_MAX_ITERATIONS=2
# Max tool executions per user turn before force-finalizing the answer.
ADAPTIVE_LOOP_MAX_TOOL_CYCLES=4

# ── Authentication (self-hosted: SQLite + JWT, see auth.py) ────────────────
# Required — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Without this, a random secret is generated on each restart and all
# existing login sessions are invalidated every time the server restarts.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_DAYS=7
# Must match the frontend's exact origin — required for the httpOnly auth
# cookie to work cross-origin (comma-separate multiple origins if needed).
FRONTEND_ORIGIN=http://localhost:3000
# Set to true once served over HTTPS in production (cookie won't be sent
# over plain http otherwise).
COOKIE_SECURE=false

# Resend (https://resend.com) free tier — used to send verification and
# password-reset emails. Leave RESEND_API_KEY blank to log emails to the
# server console instead of sending them (fine for local dev/testing).
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Synapse AI <onboarding@resend.dev>

# Where chatbot.db / auth.db are written. Leave unset for local dev (they
# live next to the backend code). On a host with an ephemeral container
# filesystem (e.g. a free Hugging Face Space, which wipes non-repo files on
# every rebuild), set this to an attached persistent volume's mount path
# (HF Spaces Persistent Storage mounts at /data) so accounts and chat
# history survive redeploys.
# DATA_DIR=/data
